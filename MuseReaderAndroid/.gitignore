# Publish the app/build source, following the same boundary as the iOS project.
# Audit reports, recordings, store material and local notes remain on this machine.
/*
!/.gitignore
!/README.md
!/SOURCE_RELEASES.md
!/THIRD_PARTY_NOTICES.md
!/ios-shared-sources.txt
!/Aria/
!/engine/
!/scripts/

/scripts/*
!/scripts/build-engine.sh
!/scripts/build-render-core.sh
!/scripts/generate-bridge-types.py
!/scripts/generate-symbols.py
!/scripts/inspect-play-bundle.py
!/scripts/link-ios-sources.sh
!/scripts/make-launcher-icon.py
!/scripts/setup-upload-key.py
!/scripts/skip-arm64-only.sh

.DS_Store
__pycache__/
*.pyc
.gradle/
.idea/
.kotlin/
.build/
build/
.cxx/
DerivedData/
xcuserdata/
captures/
screenshots/
fastlane/
local.properties
keystore.properties
*.keystore
*.jks
*.p12
*.mobileprovision
*.apk
*.aab
*.apks
*.log
*.hprof
*.perfetto-trace

# Same optional promotional/video media excluded by the iOS source tree.
VideoBackgrounds/
WhatsNew/
